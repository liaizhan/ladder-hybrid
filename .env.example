# Copy to .env.local and fill in. Never commit .env.local.
# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required). Production: a reCAPTCHA site key.
# VITE_APPCHECK_PROVIDER is "enterprise" (reCAPTCHA Enterprise, default) or "v3" (reCAPTCHA v3).
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_PROVIDER=enterprise
# Development: put a debug token registered in the Firebase console here
# (or "true" to let the SDK print a new one in the browser console).
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: cloud model name (default is the SDK default for hybrid mode)
VITE_CLOUD_MODEL=
